	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.932846129523-ltb00kpjgot5s78a9n43iar45mt50ove</string>
			</array>
		</dict>
	</array>
